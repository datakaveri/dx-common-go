// The examples module is separate from dx-common-go so its demo-only
// dependencies (a main package, config file) never leak into the library's
// dependency graph. The replace directive points back at the parent so the
// example always compiles against the working tree — which is the point: CI
// building this module is what keeps the template from rotting.
module github.com/datakaveri/dx-common-go/examples

go 1.26.5

replace github.com/datakaveri/dx-common-go => ../

require (
	github.com/datakaveri/dx-common-go v0.0.0-00010101000000-000000000000
	github.com/exaring/otelpgx v0.11.1
	github.com/go-chi/chi/v5 v5.3.0
	github.com/jackc/pgx/v5 v5.10.0
	go.uber.org/zap v1.28.0
)

require (
	github.com/beorn7/perks v1.0.1 // indirect
